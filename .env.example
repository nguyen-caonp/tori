# Copy to .env and fill in. .env is gitignored — never commit real values.

# Simplero API key (account settings -> API). Sent as HTTP Basic username
# with an empty password, or as the X-API-Key header.
SIMPLERO_API_KEY=

# Simplero requires an identifying User-Agent on every request or it returns
# 400 {"error": "Incorrect User-Agent"}.
SIMPLERO_USER_AGENT="tori (ai-automation@awesm.com)"

SIMPLERO_BASE_URL=https://simplero.com/api/v2
